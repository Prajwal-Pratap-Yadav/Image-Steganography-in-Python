include LICENSE Makefile CITATION.cff CHANGELOG.md SECURITY.md CONTRIBUTING.md CODE_OF_CONDUCT.md requirements*.lock requirements*.in
recursive-include docs *.md *.png
recursive-include reports *.json *.csv *.png
recursive-include scripts *.py
recursive-include configs *.json
recursive-include examples *.png *.txt *.md
recursive-include tests *.py
recursive-include legacy *.py *.md
prune reports/local
prune .venv
prune .tools
prune .wheelcheck
